<?xml version="1.0" encoding="utf-8"?>
<!--
    strings.xml (English) — ข้อความภาษาอังกฤษ
    ============================================================
    ไฟล์นี้เก็บ String resource ภาษาอังกฤษ (ค่า default)
    Android จะดึงจาก values-th/strings.xml เมื่อเครื่องตั้งเป็นภาษาไทย
    ห้ามใส่ข้อความ hard-code ในโค้ด Kotlin ให้ใช้ stringResource(R.string.xxx) แทน
-->
